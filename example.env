# ── 必填 ─────────────────────────────────────────────────────
# 浏览器正在观看的播放页地址（含 ib= 或 ep=）
# 标题、sid、MPD、channel_id、CloudFront 签名 Cookie 全部由此自动获取
PLAYER_URL=https://live.eplus.jp/ex/player?ep=xxx

# 浏览器 Cookie：只需 live.eplus.jp 的会话 Cookie（如 KOJIN_SHIKIBETSU、ci_session）
# 不要填 CloudFront-*，它们会由 PLAYER_URL 自动签发并定时刷新
COOKIE_MPD="KOJIN_SHIKIBETSU=xxx; ci_session=xxx"

# Widevine 设备文件
WVD_PATH=./bin/google_aosp_on_ia_emulator_14.0.0_9389cec2_4464_l3.wvd

# ── 可选（一般不用改）─────────────────────────────────────────
# 不填则由 PLAYER_URL 推导
# URL_MPD=https://stream.live.eplus.jp/out/v1/xxx/index.mpd
# AUTH_URL=https://live.eplus.jp/api/stream/xxx/get_auth_token_drm?channel_id=xxx

# 文件名前缀（默认取直播标题）
# TITLE=My Live Title

# 输出目录 / 录制上限（HH:mm:ss）
# OUTPUT_DIR=./Downloads
# RECORD_LIMIT=02:00:00
